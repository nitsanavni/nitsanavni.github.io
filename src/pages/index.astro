---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { excerpt } from '../site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <div class="posts">
    {
      posts.map((post) => (
        <article class="post">
          <h1>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </h1>

          <div class="entry">
            {post.data.description?.trim() ? (
              <p>{post.data.description}</p>
            ) : (
              <Fragment set:html={excerpt(post.rendered?.html ?? '')} />
            )}
          </div>

          <a href={`/${post.id}/`} class="read-more">
            Read More
          </a>
        </article>
      ))
    }
  </div>
</Base>
